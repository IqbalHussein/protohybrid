# Supabase — from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Strava — from https://www.strava.com/settings/api (set up at Next Steps #5)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Google Calendar — from your Google Cloud project's OAuth credentials (set up at Next Steps #6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
