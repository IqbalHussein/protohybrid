# Supabase — from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Strava — from https://www.strava.com/settings/api. Optional: the redirect URI
# defaults to <origin>/api/auth/strava/callback; the app's domain must be set as
# the "Authorization Callback Domain" there.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

# Google Calendar — from your Google Cloud project's OAuth credentials. The
# redirect URI must be listed exactly under the OAuth client's authorized
# redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Background sync (optional). Without these, sync runs only on connect and
# from "Sync now". Server-only: never give these a NEXT_PUBLIC_ prefix.
# Service role key: Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as a bearer token.
CRON_SECRET=
# Any random string; echoed by Strava when the webhook subscription is created.
STRAVA_WEBHOOK_VERIFY_TOKEN=
